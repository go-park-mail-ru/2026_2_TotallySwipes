# --- Database ---
DATABASE_URL=postgres://app:app@localhost:5432/dating_app?sslmode=disable

# --- Redis ---
REDIS_ADDR=localhost:6379

# --- Auth ---
JWT_SECRET=change-me
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=720h
# COOKIE_SECURE=true

# --- HTTP ---
# PORT=8080
# PUBLIC_URL=http://localhost:8080  # адрес API для ссылок на фото
# CORS_ORIGINS=http://localhost:5173  # origin фронтенда через запятую
# HTTP_READ_HEADER_TIMEOUT=5s
# HTTP_READ_TIMEOUT=10s
# HTTP_WRITE_TIMEOUT=10s
# HTTP_IDLE_TIMEOUT=60s

# ID текущего TIPI-теста в таблице test (создаётся миграцией с id 1); 0 — тест не настроен.
