# Для make up-all - приложение тоже в докере, БД доступна по имени сервиса.
# Значения должны совпадать с POSTGRES_* ниже.
DATABASE_URL=postgres://app:app@postgres:5432/dating_app?sslmode=disable
JWT_SECRET=change-me
REDIS_ADDR=redis:6379

# Настройки постгреса
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=dating_app

# Опционально
PORT=8080