# --- Postgres (для контейнера postgres) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=dating_app

# --- Database (значения должны совпадать с POSTGRES_* выше) ---
DATABASE_URL=postgres://app:app@postgres:5432/dating_app?sslmode=disable

# --- Redis ---
REDIS_ADDR=redis:6379

# --- Auth ---
JWT_SECRET=change-me
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=720h
# COOKIE_SECURE=true

# --- HTTP (всё опционально, ниже дефолты) ---
# PORT=8080
# PUBLIC_URL=http://localhost:8080  # адрес API для ссылок на фото
# CORS_ORIGINS=http://localhost:5173  # origin фронтенда через запятую
# API_BIND=127.0.0.1  # на сервере должен быть 0.0.0.0, чтобы API был доступен снаружи
# HTTP_READ_HEADER_TIMEOUT=5s
# HTTP_READ_TIMEOUT=10s
# HTTP_WRITE_TIMEOUT=10s
# HTTP_IDLE_TIMEOUT=60s


# Timepad: токен без префикса Bearer, полный URL метода событий.
TIMEPAD_API_TOKEN=replace-with-timepad-token
TIMEPAD_BASE_URL=https://api.timepad.ru/v1/events.json
TIMEPAD_HTTP_CLIENT_TIMEOUT=5s
EVENT_SEARCH_TTL=24h

# --- Compose ---
API_IMAGE=totallyswipes-api
API_BIND=127.0.0.1
PORT=8080

# --- Redis ---
LOCATION_PREVIEW_TTL=10m

# --- Auth ---
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
COOKIE_SECURE=false

# --- HTTP ---
PUBLIC_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5173
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s

# --- MinIO: учётные данные приложения должны совпадать с ROOT ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-minio-password
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=replace-with-minio-password
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_USE_TLS=false
MINIO_BUCKET=photos
MINIO_PHOTO_URL_TTL=15m

# --- Geocoder: замените URL и ключ значениями провайдера ---
GEOCODER_API_KEY=replace-with-geocoder-key
GEOCODER_BASE_URL=https://geocoder.example.com/v1/reverse
GEOCODER_HTTP_CLIENT_TIMEOUT=5s

# --- Каталоги внутри контейнера API (также заданы в Compose) ---
PHOTO_DIR=/photos
LOG_DIR=/logs
