FROM golang:1.27 AS build
WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
ARG SERVICE_PATH
ARG VERSION=development
RUN test -n "$SERVICE_PATH" && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X dating-app/internal/buildinfo.Revision=$VERSION" -o /service "$SERVICE_PATH"
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /healthcheck ./cmd/healthcheck

FROM alpine:3.24
ARG SERVICE_PATH
RUN apk add --no-cache ca-certificates && \
    if [ "$SERVICE_PATH" = "./services/chat/cmd" ]; then apk add --no-cache ffmpeg; fi
WORKDIR /app
COPY --from=build /service /usr/local/bin/service
COPY --from=build /healthcheck /usr/local/bin/healthcheck
ENTRYPOINT ["/usr/local/bin/service"]
