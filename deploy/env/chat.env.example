GRPC_PORT=50051
DATABASE_URL=postgres://chat_app:replace-chat-password@postgres:5432/dating_app?sslmode=disable&application_name=chat
REDIS_ADDR=redis:6379
PROFILE_GRPC_ADDR=profile:50051
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=chat_storage
MINIO_SECRET_KEY=replace-chat-storage-password
MINIO_BUCKET=chat-media
MINIO_USE_TLS=false
LOG_LEVEL=info
LOG_DIR=/logs/chat
MINIO_DOWNLOAD_URL_TTL=15m
CHAT_EVENT_QUEUE_SIZE=100
FFPROBE_PATH=ffprobe
CONNECT_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s
