GRPC_PORT=50051
DATABASE_URL=postgres://auth_app:replace-auth-password@postgres:5432/dating_app?sslmode=disable&application_name=auth
REDIS_ADDR=redis:6379
PROFILE_GRPC_ADDR=profile:50051
GRPC_REQUEST_TIMEOUT=5s
JWT_SECRET=replace-shared-jwt-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
LOG_LEVEL=info
LOG_DIR=/logs/auth
SHUTDOWN_TIMEOUT=10s
