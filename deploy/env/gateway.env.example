PORT=8080
AUTH_GRPC_ADDR=auth:50051
PROFILE_GRPC_ADDR=profile:50051
MATCHING_GRPC_ADDR=matching:50051
CHAT_GRPC_ADDR=chat:50051
GRPC_REQUEST_TIMEOUT=5s
JWT_SECRET=replace-shared-jwt-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
COOKIE_SECURE=true
CORS_ORIGINS=https://totally-swipes.ru
WS_ALLOWED_ORIGINS=https://totally-swipes.ru
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
WS_HANDSHAKE_TIMEOUT=5s
WS_WRITE_TIMEOUT=10s
WS_PONG_TIMEOUT=60s
WS_PING_INTERVAL=25s
WS_MAX_MESSAGE_BYTES=65536
WS_SEND_QUEUE_SIZE=64
WS_COMMANDS_QUEUE_SIZE=64
SHUTDOWN_TIMEOUT=10s
LOG_LEVEL=info
LOG_DIR=/logs/gateway
TLS_CERT_FILE=
TLS_KEY_FILE=
