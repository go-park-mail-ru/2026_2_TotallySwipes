// Полная физическая модель Totally Swipes.
// PostgreSQL.
// Все id в итоговом DDL:
// GENERATED ALWAYS AS IDENTITY.
//
// created_at / updated_at:
// DEFAULT CURRENT_TIMESTAMP.
// updated_at изменяется backend либо общим BEFORE UPDATE trigger.
//
// Межтабличные бизнес-ограничения, которые невозможно выразить
// обычными CHECK/FK/UNIQUE, описываются в relations.md.

Project totally_swipes {
  database_type: 'PostgreSQL'
  Note: '''
  Физическая модель сервиса знакомств Totally Swipes.

  История анкет хранится в profile_version.
  История психологических тестирований — в profile_psycho и user_answer.

  Файлы фотографий хранятся в S3-совместимом хранилище.
  База данных хранит только уникальный storage_key.

  Межтабличные проверки и правила неизменяемости истории
  описаны в relations.md.
  '''
}


/* =========================================================
   USER
   ========================================================= */

Table "user" {
  id bigint [pk, not null]
  name text [not null]
  email text [not null, unique]
  password_hash text [not null]

  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  checks {
    `id > 0` [name: 'user_id_positive']

    `char_length(name) BETWEEN 1 AND 100
      AND name ~ '[^[:space:]]'`
      [name: 'user_name_valid']

    `char_length(email) BETWEEN 1 AND 254
      AND email !~ '[[:space:]]'`
      [name: 'user_email_valid']

    `password_hash ~ '[^[:space:]]'`
      [name: 'user_password_hash_nonblank']

    `isfinite(created_at)`
      [name: 'user_created_at_finite']

    `isfinite(updated_at)`
      [name: 'user_updated_at_finite']

    `updated_at >= created_at`
      [name: 'user_updated_not_before_created']
  }

  Note: '''
  Проверка синтаксиса email выполняется приложением.
  В БД хранится только хеш пароля.

  UNIQUE(email) сейчас регистрозависим.
  При необходимости регистронезависимой уникальности
  следует использовать индекс по lower(email)
  либо отдельное согласованное решение.
  '''
}


/* =========================================================
   PROFILE
   ========================================================= */

Table "profile" {
  id bigint [pk, not null]
  user_id bigint [not null, unique]

  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  checks {
    `id > 0`
      [name: 'profile_id_positive']

    `isfinite(created_at)`
      [name: 'profile_created_at_finite']

    `isfinite(updated_at)`
      [name: 'profile_updated_at_finite']

    `updated_at >= created_at`
      [name: 'profile_updated_not_before_created']
  }

  Note: '''
  Постоянная идентичность анкеты.

  Один user имеет ровно один profile благодаря UNIQUE(user_id).

  При регистрации user, profile и первая profile_version
  создаются одной транзакцией.

  user_id после создания profile не изменяется.
  '''
}


/* =========================================================
   PROFILE VERSION
   ========================================================= */

Table "profile_version" {
  id bigint [pk, not null]
  profile_id bigint [not null]

  revision integer [not null]
  recorded_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  birth_date date [not null]
  sex text [not null]

  search_sex text [not null]
  search_age_from integer [not null]
  search_age_to integer [not null]

  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (profile_id, revision) [unique]
  }

  checks {
    `id > 0`
      [name: 'profile_version_id_positive']

    `revision > 0`
      [name: 'profile_version_revision_positive']

    `isfinite(recorded_at)`
      [name: 'profile_version_recorded_at_finite']

    `isfinite(birth_date)`
      [name: 'profile_version_birth_date_finite']

    `sex IN ('male', 'female')`
      [name: 'profile_version_sex_valid']

    `search_sex IN ('male', 'female', 'all')`
      [name: 'profile_version_search_sex_valid']

    `search_age_from >= 18
      AND search_age_to >= search_age_from`
      [name: 'profile_version_search_age_valid']

    `isfinite(created_at)`
      [name: 'profile_version_created_at_finite']

    `isfinite(updated_at)`
      [name: 'profile_version_updated_at_finite']

    `updated_at >= created_at`
      [name: 'profile_version_updated_not_before_created']
  }

  Note: '''
  Неизменяемый снимок полей анкеты.

  Текущая версия — строка с максимальным revision
  для конкретного profile_id.

  Новая версия создаётся с revision + 1
  под блокировкой profile.

  UPDATE/DELETE исторических версий запрещаются
  бизнес-правилами / правами / trigger.

  updated_at присутствует согласно требованиям физической модели;
  для неизменяемой строки он остаётся равен времени создания.
  '''
}


/* =========================================================
   PSYCHO TEST
   ========================================================= */

Table "test" {
  id bigint [pk, not null]
  name text [not null]

  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  checks {
    `id > 0`
      [name: 'test_id_positive']

    `char_length(name) BETWEEN 1 AND 200
      AND name ~ '[^[:space:]]'`
      [name: 'test_name_valid']

    `isfinite(created_at)`
      [name: 'test_created_at_finite']

    `isfinite(updated_at)`
      [name: 'test_updated_at_finite']

    `updated_at >= created_at`
      [name: 'test_updated_not_before_created']
  }

  Note: '''
  Имя теста не обязано быть UNIQUE.

  Тест, который уже проходили пользователи,
  не изменяется семантически.
  Новая редакция теста создаётся как новый test.
  '''
}


Table "question" {
  id bigint [pk, not null]
  test_id bigint [not null]

  operation_id integer [not null]
  body text [not null]

  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  checks {
    `id > 0`
      [name: 'question_id_positive']

    `operation_id > 0`
      [name: 'question_operation_positive']

    `char_length(body) BETWEEN 1 AND 2000
      AND body ~ '[^[:space:]]'`
      [name: 'question_body_valid']

    `isfinite(created_at)`
      [name: 'question_created_at_finite']

    `isfinite(updated_at)`
      [name: 'question_updated_at_finite']

    `updated_at >= created_at`
      [name: 'question_updated_not_before_created']
  }

  Note: '''
  operation_id — идентификатор операции алгоритма backend,
  а не FK.

  Допустимость operation_id проверяется по реестру операций backend.

  Вопрос использованного теста нельзя изменять таким образом,
  чтобы изменилась семантика уже сохранённых ответов.
  '''
}


Table "profile_psycho" {
  id bigint [pk, not null]

  profile_id bigint [not null]
  test_id bigint [not null]

  revision integer [not null]

  recorded_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  weight_1 numeric [null]
  weight_2 numeric [null]
  weight_3 numeric [null]
  weight_4 numeric [null]
  weight_5 numeric [null]

  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (profile_id, revision) [unique]
  }

  checks {
    `id > 0`
      [name: 'profile_psycho_id_positive']

    `revision > 0`
      [name: 'profile_psycho_revision_positive']

    `isfinite(recorded_at)`
      [name: 'profile_psycho_recorded_at_finite']

    `
    (
      weight_1 IS NULL
      AND weight_2 IS NULL
      AND weight_3 IS NULL
      AND weight_4 IS NULL
      AND weight_5 IS NULL
    )
    OR
    (
      weight_1 IS NOT NULL
      AND weight_2 IS NOT NULL
      AND weight_3 IS NOT NULL
      AND weight_4 IS NOT NULL
      AND weight_5 IS NOT NULL
    )
    `
      [name: 'profile_psycho_weights_complete']

    `
      weight_1 <> 'NaN'::numeric
      AND weight_1 <> 'Infinity'::numeric
      AND weight_1 <> '-Infinity'::numeric
    `
      [name: 'profile_psycho_weight_1_finite']

    `
      weight_2 <> 'NaN'::numeric
      AND weight_2 <> 'Infinity'::numeric
      AND weight_2 <> '-Infinity'::numeric
    `
      [name: 'profile_psycho_weight_2_finite']

    `
      weight_3 <> 'NaN'::numeric
      AND weight_3 <> 'Infinity'::numeric
      AND weight_3 <> '-Infinity'::numeric
    `
      [name: 'profile_psycho_weight_3_finite']

    `
      weight_4 <> 'NaN'::numeric
      AND weight_4 <> 'Infinity'::numeric
      AND weight_4 <> '-Infinity'::numeric
    `
      [name: 'profile_psycho_weight_4_finite']

    `
      weight_5 <> 'NaN'::numeric
      AND weight_5 <> 'Infinity'::numeric
      AND weight_5 <> '-Infinity'::numeric
    `
      [name: 'profile_psycho_weight_5_finite']

    `isfinite(created_at)`
      [name: 'profile_psycho_created_at_finite']

    `isfinite(updated_at)`
      [name: 'profile_psycho_updated_at_finite']

    `updated_at >= created_at`
      [name: 'profile_psycho_updated_not_before_created']
  }

  Note: '''
  Одно прохождение психологического теста.

  Пока тест не завершён — все weight_N = NULL.
  После завершения заполнены все пять весов.

  Повторное прохождение создаёт новую строку.

  revision увеличивается в пределах profile_id.
  '''
}


Table "user_answer" {
  profile_psycho_id bigint [not null]
  question_id bigint [not null]

  answer_value smallint [not null]

  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (profile_psycho_id, question_id) [pk]
  }

  checks {
    `answer_value BETWEEN 0 AND 7`
      [name: 'user_answer_value_valid']

    `isfinite(created_at)`
      [name: 'user_answer_created_at_finite']

    `isfinite(updated_at)`
      [name: 'user_answer_updated_at_finite']

    `updated_at >= created_at`
      [name: 'user_answer_updated_not_before_created']
  }

  Note: '''
  0 — точно нет.
  7 — точно да.

  Один вопрос имеет максимум один ответ
  в рамках одного прохождения благодаря составному PK.

  question_id должен принадлежать тому же test,
  что profile_psycho.test_id.
  Это межтабличное ограничение, описанное в relations.md.

  После завершения прохождения ответы неизменяемы.
  '''
}


/* =========================================================
   SUBSCRIPTIONS
   ========================================================= */

Table "plan" {
  id bigint [pk, not null]
  name text [not null, unique]

  ads_enabled boolean [not null, default: true]

  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  checks {
    `id > 0`
      [name: 'plan_id_positive']

    `char_length(name) BETWEEN 1 AND 100
      AND name ~ '[^[:space:]]'`
      [name: 'plan_name_valid']

    `isfinite(created_at)`
      [name: 'plan_created_at_finite']

    `isfinite(updated_at)`
      [name: 'plan_updated_at_finite']

    `updated_at >= created_at`
      [name: 'plan_updated_not_before_created']
  }

  Note: '''
  name уникально идентифицирует название тарифа.
  ads_enabled по умолчанию TRUE:
  новый тариф считается рекламным, пока явно не указано обратное.
  '''
}


Table "subscription" {
  id bigint [pk, not null]

  user_id bigint [not null]
  plan_id bigint [not null]

  starts_at timestamptz [not null]
  ends_at timestamptz [not null]

  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  checks {
    `id > 0`
      [name: 'subscription_id_positive']

    `isfinite(starts_at) AND isfinite(ends_at)`
      [name: 'subscription_period_finite']

    `ends_at > starts_at`
      [name: 'subscription_period_valid']

    `isfinite(created_at)`
      [name: 'subscription_created_at_finite']

    `isfinite(updated_at)`
      [name: 'subscription_updated_at_finite']

    `updated_at >= created_at`
      [name: 'subscription_updated_not_before_created']
  }

  Note: '''
  Период подписки задаётся полуинтервалом [starts_at, ends_at).

  Для одного пользователя периоды активных подписок
  не должны пересекаться.

  Это следует обеспечить EXCLUDE constraint
  либо эквивалентным транзакционным механизмом.
  '''
}


/* =========================================================
   TAGS
   ========================================================= */

Table "tag" {
  id bigint [pk, not null]
  name text [not null, unique]

  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  checks {
    `id > 0`
      [name: 'tag_id_positive']

    `char_length(name) BETWEEN 1 AND 100
      AND name ~ '[^[:space:]]'`
      [name: 'tag_name_valid']

    `isfinite(created_at)`
      [name: 'tag_created_at_finite']

    `isfinite(updated_at)`
      [name: 'tag_updated_at_finite']

    `updated_at >= created_at`
      [name: 'tag_updated_not_before_created']
  }

  Note: '''
  Справочник тегов анкеты.

  Например:
  sport,
  gaming,
  travelling.

  Пользователь выбирает существующие теги,
  произвольные строки непосредственно в profile не хранятся.
  '''
}


Table "profile_tag" {
  profile_id bigint [not null]
  tag_id bigint [not null]

  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (profile_id, tag_id) [pk]
  }

  checks {
    `isfinite(created_at)`
      [name: 'profile_tag_created_at_finite']

    `isfinite(updated_at)`
      [name: 'profile_tag_updated_at_finite']

    `updated_at >= created_at`
      [name: 'profile_tag_updated_not_before_created']
  }

  Note: '''
  Связь M:N profile <-> tag.

  Составной PRIMARY KEY одновременно запрещает
  повторный выбор одного тега одним profile.
  '''
}


/* =========================================================
   REPORTS
   ========================================================= */

Table "report_type" {
  id bigint [pk, not null]

  name text [not null, unique]

  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  checks {
    `id > 0`
      [name: 'report_type_id_positive']

    `char_length(name) BETWEEN 1 AND 100
      AND name ~ '[^[:space:]]'`
      [name: 'report_type_name_valid']

    `isfinite(created_at)`
      [name: 'report_type_created_at_finite']

    `isfinite(updated_at)`
      [name: 'report_type_updated_at_finite']

    `updated_at >= created_at`
      [name: 'report_type_updated_not_before_created']
  }
}


Table "report" {
  id bigint [pk, not null]

  author_id bigint [not null]
  reported_user_id bigint [not null]
  report_type_id bigint [not null]

  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (author_id, reported_user_id, report_type_id) [unique]
  }

  checks {
    `id > 0`
      [name: 'report_id_positive']

    `author_id <> reported_user_id`
      [name: 'report_not_self']

    `isfinite(created_at)`
      [name: 'report_created_at_finite']

    `isfinite(updated_at)`
      [name: 'report_updated_at_finite']

    `updated_at >= created_at`
      [name: 'report_updated_not_before_created']
  }

  Note: '''
  Пользователь не может пожаловаться на себя.

  Одинаковая жалоба одного типа от одного пользователя
  на одного и того же пользователя допускается только один раз.
  '''
}


/* =========================================================
   PHOTOS
   ========================================================= */

Table "photo" {
  id bigint [pk, not null]

  profile_id bigint [not null]

  storage_key text [not null, unique]

  position smallint [not null]

  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (profile_id, position) [unique]
  }

  checks {
    `id > 0`
      [name: 'photo_id_positive']

    `storage_key ~ '[^[:space:]]'
      AND char_length(storage_key) <= 1024`
      [name: 'photo_storage_key_valid']

    `position > 0`
      [name: 'photo_position_positive']

    `isfinite(created_at)`
      [name: 'photo_created_at_finite']

    `isfinite(updated_at)`
      [name: 'photo_updated_at_finite']

    `updated_at >= created_at`
      [name: 'photo_updated_not_before_created']
  }

  Note: '''
  Изображение физически хранится в S3.

  storage_key — ключ объекта в S3, а не публичный URL.

  UNIQUE(storage_key) запрещает привязать один S3-объект
  к нескольким photo.

  UNIQUE(profile_id, position) определяет порядок фотографий.

  Максимальное количество фотографий у profile
  является межстрочным ограничением и проверяется backend
  либо trigger.
  '''
}


/* =========================================================
   PHOTO COMMENTS
   ========================================================= */

Table "photo_comment" {
  id bigint [pk, not null]

  author_id bigint [not null]
  photo_id bigint [not null]

  body text [not null]

  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  checks {
    `id > 0`
      [name: 'photo_comment_id_positive']

    `char_length(body) BETWEEN 1 AND 2000
      AND body ~ '[^[:space:]]'`
      [name: 'photo_comment_body_valid']

    `isfinite(created_at)`
      [name: 'photo_comment_created_at_finite']

    `isfinite(updated_at)`
      [name: 'photo_comment_updated_at_finite']

    `updated_at >= created_at`
      [name: 'photo_comment_updated_not_before_created']
  }
}


/* =========================================================
   LIKES
   ========================================================= */

Table "profile_like" {
  id bigint [pk, not null]

  author_id bigint [not null]
  profile_id bigint [not null]

  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (author_id, profile_id) [unique]
  }

  checks {
    `id > 0`
      [name: 'profile_like_id_positive']

    `isfinite(created_at)`
      [name: 'profile_like_created_at_finite']

    `isfinite(updated_at)`
      [name: 'profile_like_updated_at_finite']

    `updated_at >= created_at`
      [name: 'profile_like_updated_not_before_created']
  }

  Note: '''
  Один пользователь может лайкнуть конкретный profile
  не более одного раза.

  Запрет лайка собственного profile нельзя выразить
  простым CHECK, поскольку author_id ссылается на user,
  а profile_id — на profile.

  Правило:
    profile.user_id <> profile_like.author_id

  проверяется backend либо trigger.
  '''
}


/* =========================================================
   MATCH
   ========================================================= */

Table "match" {
  id bigint [pk, not null]

  first_user_id bigint [not null]
  second_user_id bigint [not null]

  access_to_message boolean [not null, default: true]

  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (first_user_id, second_user_id) [unique]
  }

  checks {
    `id > 0`
      [name: 'match_id_positive']

    `first_user_id < second_user_id`
      [name: 'match_users_canonical_order']

    `isfinite(created_at)`
      [name: 'match_created_at_finite']

    `isfinite(updated_at)`
      [name: 'match_updated_at_finite']

    `updated_at >= created_at`
      [name: 'match_updated_not_before_created']
  }

  Note: '''
  Пользователь не может иметь match с самим собой.

  Пара пользователей всегда хранится в каноническом порядке:
  first_user_id < second_user_id.

  Поэтому UNIQUE(first_user_id, second_user_id)
  запрещает одновременно создать пары (1, 2) и (2, 1).

  Создание match допустимо только при наличии
  взаимных лайков пользователей.
  Это межтабличное бизнес-ограничение.
  '''
}


/* =========================================================
   MESSAGE
   ========================================================= */

Table "message" {
  id bigint [pk, not null]

  match_id bigint [not null]
  sender_id bigint [not null]

  body text [not null]

  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  checks {
    `id > 0`
      [name: 'message_id_positive']

    `char_length(body) BETWEEN 1 AND 10000
      AND body ~ '[^[:space:]]'`
      [name: 'message_body_valid']

    `isfinite(created_at)`
      [name: 'message_created_at_finite']

    `isfinite(updated_at)`
      [name: 'message_updated_at_finite']

    `updated_at >= created_at`
      [name: 'message_updated_not_before_created']
  }

  Note: '''
  sender_id обязан быть одним из двух участников match.

  Также отправка разрешена только при
  match.access_to_message = TRUE.

  Оба правила являются межтабличными и требуют
  проверки backend либо trigger.
  '''
}


